# Copy to .env and set a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
# Comma-separated browser origins allowed to make state-changing API calls
CLIENT_ORIGIN=http://localhost:5173
# Set to true when served over HTTPS
COOKIE_SECURE=false
# DB_PATH=./data/spot.db
